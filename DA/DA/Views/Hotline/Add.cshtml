@model DA.Models.Hotline
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="brand_color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>LIÊN HỆ CHÚNG TÔI</h2>
                    <p>Chúng tôi hoạt động 24/24.Luôn lắng nghe và thấu hiểu. XIN CHÂN THÀNH CẢM ƠN!!</p>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="contact">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <form asp-action="Add" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group">
                        <label asp-for="Name">Họ và tên</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SDT">Số điện thoại</label>
                        <input asp-for="SDT" class="form-control" />
                        <span asp-validation-for="SDT" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Mô tả vấn đề của bạn</label>
                        <textarea asp-for="Description" class="form-control"></textarea>

                        <span asp-validation-for="Description" class="text-danger"></span>

                    </div>
                    <button type="submit" class="btn btn-primary">Gửi</button>

                </form>
                <br>
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.4206985418705!2d106.78253487570396!3d10.855572157727538!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3175276e7ea103df%3A0xb6cf10bb7d719327!2zSFVURUNIIC0gxJDhuqFpIGjhu41jIEPDtG5nIG5naOG7hyBUUC5IQ00gKFRodSBEdWMgQ2FtcHVzKQ!5e0!3m2!1svi!2s!4v1713122893601!5m2!1svi!2s" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                <br>
            </div>
        </div>
    </div>
</div>
