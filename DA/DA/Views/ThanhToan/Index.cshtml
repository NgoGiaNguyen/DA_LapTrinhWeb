@model ShoppingCart
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <main role="main">
        <!-- Block content - Đục lỗ trên giao diện bố cục chung, đặt tên là `content` -->
        <div class="container mt-4">
                <div class="brand_color">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="titlepage">
                                    <h2>Thanh toán</h2>
                                    <p>Vui lòng kiểm tra thông tin khách hàng, thông tin giỏ hàng trước khi Đặt Hàng!!!.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            <form class="needs-validation" method="post" asp-action="Checkout">
                <div class="row">
                    <div class="col-md-4 order-md-2 mb-4">
                        <h4 class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Giỏ hàng</span>
                            <span class="badge badge-secondary badge-pill">@Model.Items.Count</span>
                        </h4>
                        <ul class="list-group mb-3">

                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between lh-condensed">
                                 
                                    <div>
                                        <h6 class="text-right"> @item.Name</h6>
                                        <small class="text-right">(@item.Quantity * @string.Format("{0:N0}", @item.Price)) </small>
                                    </div>

                                    <span class="text-muted">@string.Format("{0:N0}", @item.Quantity * @item.Price) VNĐ</span>
                                </li>
                               
                            }
                        <div class="col-md-12">
                            <label asp-for="@Model.Order.Code">Mã giảm giá</label>
                            <input type="text" class="form-control" placeholder="Mã giảm giá" asp-for="@Model.Order.Code"> >
                        </div>
                        </ul>
                        
     
                    </div>
                    
                    <div class="col-md-8 order-md-1">
                        <h4 class="mb-3">Thông tin khách hàng</h4>

                        <div class="row">
                            <div class="col-md-12">
                                <label asp-for="@Model.Order.userName">Họ tên</label>
                                <input type="text" class="form-control" placeholder="Họ Tên" asp-for="@Model.Order.userName"> >
                            </div>
                            <div class="col-md-12">
                                <label asp-for="@Model.Order.ShippingAddress">Địa chỉ</label>
                                <input type="text" class="form-control" placeholder="Địa chỉ" asp-for="@Model.Order.ShippingAddress">
                            </div>
                        <br>
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.4206985418705!2d106.78253487570396!3d10.855572157727538!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3175276e7ea103df%3A0xb6cf10bb7d719327!2zSFVURUNIIC0gxJDhuqFpIGjhu41jIEPDtG5nIG5naOG7hyBUUC5IQ00gKFRodSBEdWMgQ2FtcHVzKQ!5e0!3m2!1svi!2s!4v1713122893601!5m2!1svi!2s" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        <br>
                            <div class="col-md-12">
                                <label asp-for ="@Model.Order.SDT">Điện thoại</label>
                                <input type="text" class="form-control" placeholder="Số điện thoại" asp-for="@Model.Order.SDT">
                            </div>
                            <div class="col-md-12">
                                <label asp-for="@Model.Order.Notes">Ghi chú</label>
                                <input type="text" class="form-control" placeholder="Ghi chú" asp-for="@Model.Order.Notes">
                            </div>
                        </div>

                        <h4 class="mb-3">Hình thức thanh toán</h4>
                        <div class="d-block my-3">
                            <div class="custom-control custom-radio">
                                <input id="httt-1" name="httt_ma" type="radio" class="custom-control-input" required=""
                                       value="1">
                                <label class="custom-control-label" for="httt-1">Tiền mặt</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input id="httt-2" name="httt_ma" type="radio" class="custom-control-input" required=""
                                       value="2">
                                <label class="custom-control-label" for="httt-2">Chuyển khoản</label>
                            </div>
                        </div>
                        <hr class="mb-4">
                        <button class="btn btn-primary btn-lg btn-block" type="submit" name="btnDatHang">Đặt Hàng</button>
                    </div>
                </div>
            </form>

        </div>