@model DA.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- end header -->
<div class="brand_color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Đã nhận được hàng</h2>
                </div>

            </div>
        </div>

    </div>

</div>

<!-- Lastestnews -->
<main role="main">
    <!-- Block content - Đục lỗ trên giao diện bố cục chung, đặt tên là `content` -->
    <div class="container mt-4">
        <div id="thongbao" class="alert alert-danger d-none face" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        <form asp-action="HideConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col col-md-12">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Ảnh đại diện</th>
                                <th>Tên sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="datarow">
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <img src=@item.Product.imageULR class="hinhdaidien">
                                    </td>
                                    <td class="text-right"> @item.Product.name</td>
                                    <td class="text-right">@item.Quantity</td>
                                    <td class="text-right">@string.Format("{0:N0}", @item.Price) VNĐ</td>

                                    <td class="text-right">@string.Format("{0:N0}", (@item.Price * @item.Quantity)) VNĐ</td>
                                </tr>


                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p>Vui lòng kiểm tra kỹ hàng trước khi xác nhận, mọi thắc mắc xin hãy vào trang liên hệ</p>
            <button type="submit" class="btn btn-danger">Xác nhận</button>
            <a asp-action="OrderList">Trở về</a>
        </form>

    </div>
