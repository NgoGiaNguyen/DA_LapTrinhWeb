@model IEnumerable<DA.Models.Product>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="brand_color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Chuột chính hãng</h2>
                </div>
            </div>
        </div>
    </div>

</div>
