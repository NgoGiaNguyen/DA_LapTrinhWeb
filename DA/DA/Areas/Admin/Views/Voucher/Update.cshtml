@model DA.Models.Voucher
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="brand_color">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Chỉnh sửa mã giảm giá</h2>
                </div>
            </div>
        </div>
    </div>

</div>

<form asp-action="Update" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name">Tên Mã giảm giá</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Code">Mã giảm giá</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description">Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>

        <span asp-validation-for="Description" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="Value">Giá trị giảm</label>
        <textarea asp-for="Value" class="form-control"></textarea>

        <span asp-validation-for="Value" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="SoLuong">Số lượng Mã giảm giá</label>
        <textarea asp-for="SoLuong" class="form-control"></textarea>

        <span asp-validation-for="SoLuong" class="text-danger"></span>

    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index">Trở về</a>
</form>
